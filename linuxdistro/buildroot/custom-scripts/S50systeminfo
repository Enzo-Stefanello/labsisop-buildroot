#!/bin/sh

case "$1" in
    start)
        echo "Starting SystemInfo server..."
        /usr/bin/python3 /usr/bin/systeminfo.py > /var/log/systeminfo.log 2>&1 &
        echo $! > /var/run/systeminfo.pid
        ;;
    stop)
        echo "Stopping SystemInfo server..."
        if [ -f /var/run/systeminfo.pid ]; then
            kill "$(cat /var/run/systeminfo.pid)" 2>/dev/null
            rm -f /var/run/systeminfo.pid
        fi
        ;;
    restart)
        "$0" stop
        "$0" start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
